# AutoTube Studio settings. Copy this file to config\.env and fill in only what you need; leave the rest empty.
# Restart the studio after a change. Never share this file: it holds keys.

# ---- Claude ----
# Empty = use the Claude Code login of the Windows user running the studio (run "claude" once and sign in). Recommended.
# Set an Anthropic API key here only if you want Claude calls billed to that key instead of your Claude subscription.
ANTHROPIC_API_KEY=
# Model for planning and scenes (empty = Claude Code's default)
CLAUDE_MODEL=

# ---- Voice ----
# ElevenLabs key (empty = use the key saved in the dashboard, Settings > Your voice)
ELEVENLABS_API_KEY=

# ---- Public link (Cloudflare Tunnel, no open ports needed) ----
# quick = free random https://....trycloudflare.com link (changes when the studio restarts; shown on the dashboard,
#         in data\public-url.txt and as "AutoTube Studio link" on the desktop)
# off   = no public link (dashboard only on this machine / your network)
HS_TUNNEL=quick
# Your own fixed domain later: create a tunnel in the Cloudflare dashboard (Zero Trust > Networks > Tunnels), point its
# public hostname to http://127.0.0.1:4747, and paste the tunnel token here. It replaces the random link.
CLOUDFLARE_TUNNEL_TOKEN=
# The fixed link, so the studio can show it (e.g. https://studio.example.com)
HS_PUBLIC_URL=

# ---- Machine ----
PORT=4747
# Where the Lemo Opuscar library is (empty = the path in config\settings.json)
HS_LIBRARY=
# A different Chromium for rendering (empty = Playwright's own)
PLAYWRIGHT_CHROME=
